# Copiá este archivo como .env.local y completá los valores.
# En Vercel van en el proyecto del panel → Settings → Environment Variables.

# --- Acceso -------------------------------------------------------------------
# Firma de la cookie de sesión. Un texto largo y al azar (ej. `openssl rand -base64 32`).
AUTH_SECRET=
# Hash de la contraseña del panel (la comparten todas las cuentas de src/config/users.ts).
# Se genera con: npm run hash-password -- "LaContraseña"
ADMIN_PASSWORD_HASH=

# --- Almacenamiento (Vercel Blob) -----------------------------------------------
# Se completa solo al conectar el Blob store al proyecto en Vercel (Storage → Connect).
# Para desarrollo: `vercel env pull` o copiarlo desde Vercel. Es el MISMO store que usa la web.
BLOB_READ_WRITE_TOKEN=

# --- La web ---------------------------------------------------------------------
# URL de la web: vista previa, "Ver en la web" y miniaturas de las fotos originales.
NEXT_PUBLIC_SITE_URL=https://ofirsolucionesintegrales.com
# Mismo valor que REVALIDATE_SECRET en la web: con esto la web se actualiza al guardar.
REVALIDATE_SECRET=
# (Opcional) A qué webs avisar al guardar, separadas por coma. Por defecto, NEXT_PUBLIC_SITE_URL.
# En desarrollo conviene avisar a las dos, porque comparten el almacenamiento:
# REVALIDATE_URLS=http://localhost:3000,https://ofirsolucionesintegrales.com
REVALIDATE_URLS=
