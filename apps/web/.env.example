# Resend (https://resend.com) — formulario de presupuesto
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# A dónde llegan los pedidos (se pueden poner varios separados por coma)
CONTACT_TO=ofirsolucionesintegrales@gmail.com
# Remitente con dominio verificado en Resend
CONTACT_FROM="OFIR Web <web@ofirsolucionesintegrales.com>"

# --- Contenido editable (panel en apps/admin) -------------------------------------
# Se completa solo al conectar el Blob store al proyecto en Vercel (Storage → Connect).
# Sin esta variable la web muestra los textos originales del código.
BLOB_READ_WRITE_TOKEN=
# Clave que usa el panel para avisar que hubo cambios (mismo valor en los dos proyectos).
REVALIDATE_SECRET=
# URL del panel: es el único sitio que puede mandarle contenido a /preview.
NEXT_PUBLIC_ADMIN_URL=https://admin.ofirsolucionesintegrales.com
