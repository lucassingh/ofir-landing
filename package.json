{
  "name": "ofir-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w @ofir/web",
    "dev:admin": "npm run dev -w @ofir/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "sync:brand": "npm run sync:brand -w @ofir/web",
    "hash-password": "npm run hash-password -w @ofir/admin --"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.5.1"
}
